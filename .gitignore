node_modules/
dist/
*.tsbuildinfo

# Local scratch: rendered samples, write backups, and any RPG Maker project
# folder used during development. MZ projects ship copyrighted material assets
# and must never be committed.
samples/
.rpgmaker-mcp/
demo-project/
*-project/

.env
*.log

# Generated from the engine by scripts/extract-commands.mjs. It embeds function
# bodies from a proprietary runtime, so it is built locally and never published.
src/codebook/commands.json

# Generated by scripts/extract-autotile.mjs: autotile shape indices measured out
# of a specific installation. Nothing reads it at runtime — the renderer evaluates
# the engine's own Tilemap tables — so it is investigation output, not source, and
# shipping it would contradict "no engine tables are vendored".
src/codebook/autotiles.json

# Local investigation log about the proprietary editor binary: never published.
src/bridge/FINDINGS.local.md

# Release artifacts, built by `npm pack`.
*.tgz
