{
  "name": "rpgmaker-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "MCP server that lets an AI agent see and edit an RPG Maker MZ project: engine-faithful map rendering, 78 tools, step-by-step visual editing, event-command builders and real playtesting in a browser or native NW.js",
  "license": "MIT",
  "author": "twrsm666",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "rpgmaker-mcp": "src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twrsm666/rpgmaker-mcp.git"
  },
  "homepage": "https://github.com/twrsm666/rpgmaker-mcp#readme",
  "bugs": {
    "url": "https://github.com/twrsm666/rpgmaker-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rpg-maker",
    "rpg-maker-mz",
    "tilemap",
    "visual-editor",
    "game-development",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "bin",
    "plugin",
    "preview",
    "docs",
    "examples",
    "assets",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "preview": "node src/server.js --preview-only",
    "demo": "node bin/create-demo.js",
    "test": "node --test test/*.test.js",
    "check": "node bin/check-source.js",
    "audit:release": "node bin/audit-release.js",
    "verify": "node bin/verify.js",
    "verify:runtime": "node bin/verify-browser-runtime.js",
    "verify:nw": "node bin/verify-runtime.js",
    "verify:ui": "node bin/verify-ui.js",
    "verify:steps": "node bin/verify-steps.js",
    "native:prepare": "node bin/prepare-native-runtime.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.63.0",
    "zod": "4.6.5"
  }
}
