{
  "name": "rpgmaker-mcp",
  "version": "0.4.2",
  "description": "MCP server for inspecting and editing RPG Maker MZ projects, with engine-faithful map rendering",
  "type": "module",
  "license": "MIT",
  "author": "twrsm666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twrsm666/rpgmaker-mcp.git"
  },
  "homepage": "https://github.com/twrsm666/rpgmaker-mcp#readme",
  "bugs": {
    "url": "https://github.com/twrsm666/rpgmaker-mcp/issues"
  },
  "bin": {
    "rpgmaker-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "extract:commands": "node scripts/extract-commands.mjs",
    "start": "node dist/index.js",
    "selftest": "node dist/selftest.js",
    "fix-project": "node scripts/fix-project.mjs",
    "census": "node scripts/census.mjs",
    "e2e": "node scripts/e2e-run.mjs",
    "e2e:live": "node dist/live-e2e.js",
    "verify:input": "node scripts/verify-input.mjs",
    "verify:newdata": "node scripts/verify-newdata.mjs",
    "roundtrip": "node dist/roundtrip.js",
    "fidelity:sweep": "node dist/sweep.js",
    "session:e2e": "node scripts/session-tool.mjs",
    "verify:full": "node scripts/verify-full.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "build:game": "node scripts/build-lightrun.mjs build",
    "verify:game": "node scripts/build-lightrun.mjs verify",
    "play:game": "node scripts/play-lightrun.mjs",
    "build:star-relay": "node scripts/build-star-relay.mjs build",
    "play:star-relay": "node scripts/verify-star-relay.mjs",
    "smoke:chain": "node scripts/smoke-registered.mjs"
  },
  "files": [
    "dist",
    "plugin/RMMZLiveBridge.js",
    "scripts",
    "assets",
    "LICENSE",
    "README.md",
    "ACCEPTANCE.md",
    "CHANGELOG.md",
    "REVIEW-RESPONSE.md",
    "RELEASING.md"
  ],
  "keywords": [
    "mcp",
    "rpg-maker",
    "rpg-maker-mz",
    "game-development",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@napi-rs/canvas": "^1.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0"
  }
}
